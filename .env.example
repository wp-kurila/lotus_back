# Токен от @BotFather
BOT_TOKEN=

# Telegram ID тех, кому слать уведомления и кому доступны команды статистики (через запятую).
# Свой ID можно узнать, написав боту /start.
ADMIN_IDS=

# Сервер слушает только localhost, наружу его отдаёт nginx
HOST=127.0.0.1
PORT=4000

# Домены фронта, которым разрешён CORS (через запятую). Пусто — CORS выключен.
# Для sendBeacon CORS не нужен, это только на случай fetch с application/json.
CORS_ORIGINS=https://lotusarena.life,https://www.lotusarena.life

# Разрешённые домены в ссылках афиши (через запятую, поддомены тоже подходят).
# Пусто — принимается любая http(s)-ссылка. Для локальной разработки добавь localhost.
ALLOWED_URL_HOSTS=lotusarena.life

DB_PATH=./data/stats.db
